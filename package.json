{
  "name": "@fortemate/dicechess-twitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/host/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.ts",
    "test:coverage": "npm run build && node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info --test tests/*.test.ts",
    "test:browser": "playwright test",
    "bench:candidates": "node scripts/benchmark-candidates.ts",
    "check": "npm run format:check && npm run typecheck && npm test",
    "rehearse:fixtures": "npm run build && node tests/rehearsal/host.ts",
    "rehearse:full-game": "npm run build && node --test tests/rehearsal/full-game.test.ts"
  },
  "dependencies": {
    "@fortemate/dicechess-engine": "0.14.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
